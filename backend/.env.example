# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DATABASE_NAME=fotabo_hashi
DATABASE_USER=fotabo_hashi_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# PostgreSQL backups (use an encrypted, private off-server location in production)
BACKUP_DIR=/var/backups/fotabo-hashi
BACKUP_RETENTION_DAYS=30
# Dedicated non-superuser PostgreSQL role with BYPASSRLS and read-only grants.
BACKUP_DATABASE_USER=fotabo_hashi_backup
BACKUP_DATABASE_PASSWORD=change-me

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Media storage: use local for offline development, supabase for server-side storage.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=fotabo-hashi-media
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

REDIS_URL=redis://127.0.0.1:6379/1
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
