# Local development template. Production values belong in Render/Vercel
# environment settings, not in a committed .env file.
# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_USE_REDIS_CACHE=False

# Supabase PostgreSQL (required)
# Set DATABASE_URL to your Supabase PostgreSQL connection string, e.g.
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60

# PostgreSQL backups (use an encrypted, private off-server location in production)
BACKUP_DIR=/var/backups/fotabo-hashi
BACKUP_RETENTION_DAYS=30
# Dedicated non-superuser PostgreSQL role with BYPASSRLS and read-only grants.
BACKUP_DATABASE_USER=fotabo_hashi_backup
BACKUP_DATABASE_PASSWORD=change-me

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# In production, set these to the public HTTPS frontend origin in Render.
MAX_UPLOAD_SIZE_MB=5
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Media storage: keep local for development; set to supabase after configuring credentials.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=fotabo-hashi-media
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SIGNED_URL_TTL=3600

REDIS_URL=redis://127.0.0.1:6379/1
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Error monitoring (leave SENTRY_DSN empty for local development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend and email (email backend defaults to the console in development)
FRONTEND_BASE_URL=http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=noreply@fotabohashi.org
# Resend password-reset delivery. Keep the API key server-side only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=15
# Local email fallback is used only when DEBUG=True and no Resend key is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
